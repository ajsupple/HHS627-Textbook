library(lavaan)
# ============================================================
# DATA - built inline
# ============================================================
all_vars <- c("CogJT1W", "CogJT1H", "CogJT2W", "CogJT2H",
"CogJT3W", "CogJT3H", "SaT1_W",  "SatT1_H",
"SaT2_W",  "SatT2_H",  "SaT3_W",  "SatT3_H")
means <- c(1.430693069, 1.391089109, 1.590625, 1.454910714,
1.23125, 1.333984375, 6.359735974, 6.396666667,
6.0625, 6.097560976, 6.416666667, 6.375)
names(means) <- all_vars
# Lower triangular covariance matrix
lower_tri <- c(
0.620148515,
0.287376238, 0.583019802,
0.300613133, 0.232278481, 1.025702136,
0.426325158, 0.677509042, 0.3024401,   1.102403893,
0.110275424, 0.068644068, 0.215373411, 0.141805387, 0.193233581,
0.100678943, 0.146980407, 0.053355415, 0.3915152,   0.11206303,  0.600721571,
-0.329818482,-0.170429043,-0.304245781,-0.250237342,-0.094385593, 0.031549686, 0.805962596,
-0.202912458,-0.442777778,-0.300896624,-0.524969861,-0.05769774, -0.06322338,  0.331414141, 0.784949495,
-0.094804852,-0.023206751,-0.732529008,-0.196266844,-0.195586158,-0.029857911, 0.510724332, 0.186005626, 1.49112166,
-0.352253337,-0.440379404,-0.73026973, -0.696477547,-0.072810734,-0.12952629,  0.574157717, 0.548094617, 0.95027195,  2.042490548,
0.026836158, 0.062146893,-0.167902542, 0.047316384,-0.16154661, -0.011475989, 0.270715631,-0.029190207, 0.520244821, 0.174199623, 0.733050847,
-0.12797619, -0.180555556,-0.108358935,-0.380196523,-0.134887006,-0.377893519, 0.133818342, 0.285273369, 0.192012289, 0.241181658, 0.203389831, 0.749559083
)
# Build full symmetric covariance matrix
n <- length(all_vars)
cov_full <- matrix(0, n, n)
cov_full[lower.tri(cov_full, diag = TRUE)] <- lower_tri
cov_full <- cov_full + t(cov_full) - diag(diag(cov_full))
rownames(cov_full) <- all_vars
colnames(cov_full) <- all_vars
# Subset to used variables
use_vars  <- c("CogJT1W", "CogJT2W", "CogJT3W",
"SaT1_W",  "SaT2_W",  "SaT3_W")
cov_use   <- cov_full[use_vars, use_vars]
means_use <- means[use_vars]
# ============================================================
# RICLPM MODEL
# ============================================================
model <- '
#
─
─ Random Intercept Factors
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
ricjw =~ 1*CogJT1W + 1*CogJT2W + 1*CogJT3W
risat =~ 1*SaT1_W  + 1*SaT2_W  + 1*SaT3_W
#
─
─ Occasion-Specific (Within) Factors
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
jealw1 =~ 1*CogJT1W
jealw2 =~ 1*CogJT2W
jealw3 =~ 1*CogJT3W
satw1 =~ 1*SaT1_W
satw2 =~ 1*SaT2_W
satw3 =~ 1*SaT3_W
#
─
─ Constrain Observed Residuals to Zero
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
CogJT1W ~~ 0*CogJT1W
CogJT2W ~~ 0*CogJT2W
CogJT3W ~~ 0*CogJT3W
SaT1_W  ~~ 0*SaT1_W
SaT2_W  ~~ 0*SaT2_W
SaT3_W  ~~ 0*SaT3_W
#
─
─ Autoregressions (constrained equal across lags)
─
─
─
─
─
─
jealw3 ~ lag1*jealw2
jealw2 ~ lag1*jealw1
satw3  ~ lag2*satw2
satw2  ~ lag2*satw1
#
─
─ Cross-Lagged Paths (constrained equal)
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
satw3  ~ cross1*jealw2
satw2  ~ cross1*jealw1
jealw3 ~ cross2*satw2
jealw2 ~ cross2*satw1
#
─
─ Within-Wave Covariances
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
satw1 ~~ jealw1
satw2 ~~ jealw2
satw3 ~~ jealw3
#
─
─ RI Covariance
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
ricjw ~~ risat
#
─
─ RIs Uncorrelated with Wave 1 Within Factors
─
─
─
─
─
─
─
─
─
─
ricjw ~~ 0*jealw1
ricjw ~~ 0*satw1
risat ~~ 0*jealw1
risat ~~ 0*satw1
#
─
─ Means
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
─
CogJT1W ~ 1
CogJT2W ~ 1
CogJT3W ~ 1
SaT1_W  ~ 1
SaT2_W  ~ 1
SaT3_W  ~ 1
'
# ============================================================
# FIT MODEL
# ============================================================
fit <- sem(
model,
sample.cov   = cov_use,
sample.mean  = means_use,
sample.nobs  = 120,
estimator    = "ML"
)
# ============================================================
# OUTPUT
# ============================================================
summary(fit, fit.measures = TRUE, standardized = TRUE, rsquare = TRUE)
modindices(fit, sort. = TRUE, maximum.number = 20)
# Check names match exactly
print(all_vars)       # what's in the full matrix
print(use_vars)       # what you're subsetting by
# Check for NAs in subset
print(cov_use)
any(is.na(cov_use))
# Check variances specifically
diag(cov_use)
q()
